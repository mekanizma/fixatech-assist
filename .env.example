# Canlı site adresi (SEO: canonical, sitemap, robots)
# Render'da: Environment > VITE_SITE_URL = https://your-service.onrender.com (veya özel domain)
VITE_SITE_URL=https://pragmatechnical.com.tr

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# «anon» «public» anahtar (eyJ ile başlayan JWT)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Render Web Service:
#   Build = bun install && bun run build
#   Start = bun run start   (sadece sunucu; tekrar vite build YAPMA — OOM olur)
# Bu değişkenler build sırasında Vite tarafından bundle'a gömülür (VITE_ prefix).
